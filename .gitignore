# ───────── 运行时产物 ─────────
# logs/ : 操作日志（运行时产生，不入库）
logs/

# models/ : 模型权重与归一化参数（小文件，入库）

# cache/ : 预计算缓存默认不入库，但显式保留共享给下游的产物
#          （用 cache/* 而非 cache/ 才能用 ! 重新包含其中文件）
cache/*
!cache/forecasts.parquet
!cache/cf_topn.parquet
!cache/inventory_status.parquet
!cache/*_metrics.json

# 注：data/ 下的小型 parquet 文件保留入库，方便直接运行无需原始 csv
data/users.json                # 运行时自动生成，含用户哈希不入库
